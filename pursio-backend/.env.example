NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pursio:change-me@127.0.0.1:5434/pursio
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
REGISTRATION_KEY=replace-with-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=change-me
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5434
REDIS_IMAGE=redis:alpine
REDIS_PORT=6381
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
# For production: STORAGE_DRIVER=s3, S3_BUCKET, S3_REGION, and optional S3_ENDPOINT/credentials
