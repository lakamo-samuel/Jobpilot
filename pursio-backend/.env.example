NODE_ENV=development
PORT=4000
REDIS_URL=redis://127.0.0.1:6381
DATABASE_URL=postgresql://pursio:change-me@127.0.0.1:5434/pursio
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Google Web OAuth client. Local redirect URI: http://localhost:4000/api/auth/google/callback
# Register the exact URI in Google Cloud Console; set all three values together.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Separate Gmail consent callback; use a random 32-byte hex key (openssl rand -hex 32).
GMAIL_REDIRECT_URI=
GMAIL_TOKEN_ENCRYPTION_KEY=
POSTGRES_PASSWORD=change-me
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PORT=5434
REDIS_IMAGE=redis:alpine
REDIS_PORT=6381
# Configure Cloudinary for private CV uploads. All three values are required together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CV_MAX_FILES=10
CV_MAX_STORAGE_BYTES=104857600
# Gemini enables POST /api/opportunities/extract.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_REQUEST_LIMIT=20

# Optional country-specific Jooble search. Each country needs its own key. Example: {"NG":{"host":"ng.jooble.org","key":"YOUR_KEY"}}
JOOBLE_REGIONS_JSON={}
