{
  "name": "pursio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/cv-extraction-worker.js",
    "worker:dev": "node --env-file=.env --import tsx --watch src/cv-extraction-worker.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "typecheck:test": "tsc --project tsconfig.test.json",
    "db:push": "drizzle-kit push",
    "db:migrate:deploy": "node --env-file-if-exists=.env dist/db/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "argon2": "^0.44.0",
    "bullmq": "^6.3.9",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "file-type": "^22.1.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "html-to-text": "^10.0.1",
    "ioredis": "^6.0.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.16.0",
    "redis": "^5.12.1",
    "resend": "^6.30.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
